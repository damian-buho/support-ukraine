{
  "name": "@damian-buho/support-ukraine",
  "version": "2.2.0",
  "type": "module",
  "description": "Browser library that adds a Ukraine-support charity banner to any website.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ar": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ar.js"
    },
    "./de": {
      "types": "./dist/index.d.ts",
      "import": "./dist/de.js"
    },
    "./en": {
      "types": "./dist/index.d.ts",
      "import": "./dist/en.js"
    },
    "./es": {
      "types": "./dist/index.d.ts",
      "import": "./dist/es.js"
    },
    "./fr": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fr.js"
    },
    "./hi": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hi.js"
    },
    "./it": {
      "types": "./dist/index.d.ts",
      "import": "./dist/it.js"
    },
    "./ja": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ja.js"
    },
    "./ko": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ko.js"
    },
    "./nl": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nl.js"
    },
    "./pl": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pl.js"
    },
    "./pt": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pt.js"
    },
    "./sv": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sv.js"
    },
    "./th": {
      "types": "./dist/index.d.ts",
      "import": "./dist/th.js"
    },
    "./uk": {
      "types": "./dist/index.d.ts",
      "import": "./dist/uk.js"
    },
    "./zh": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zh.js"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsup && tsc --emitDeclarationOnly --noCheck",
    "build:test": "TEST_BUILD=1 tsup",
    "pretest": "npm run build:test",
    "test": "node --test 'dist/test/index.test.js'",
    "test:verbose": "node --test --test-reporter spec 'dist/test/index.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'dist/test/index.test.js'",
    "mutation": "stryker run",
    "audit": "npm audit",
    "check-size": "npx size-limit",
    "prepublishOnly": "npm run build",
    "lint": "eslint ./",
    "fix": "eslint ./ --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "serve": "npx serve ."
  },
  "keywords": [
    "ukraine",
    "support",
    "anti-war",
    "solidarity"
  ],
  "author": {
    "name": "Damián Búho",
    "email": "damian.buho@proton.me",
    "url": "https://dbuho.me"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/damian-buho/support-ukraine.git"
  },
  "bugs": {
    "url": "https://github.com/damian-buho/support-ukraine/issues"
  },
  "homepage": "https://github.com/damian-buho/support-ukraine#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/eslint": "9.6.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sass": "1.106.0",
    "size-limit": "14.3.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "globals": "$globals",
    "qs": "6.16.1"
  },
  "size-limit": [
    {
      "path": "./dist/index.js",
      "limit": "17 kB"
    }
  ]
}
